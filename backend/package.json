{
  "name": "@retail/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "npx -y -p tsx tsx src/migrate.ts",
    "migrate:validate": "npx -y -p tsx tsx src/migrate.validate.ts",
    "seed": "npx -y -p tsx tsx src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@retail/shared-types": "file:../packages/shared-types",
    "@supabase/supabase-js": "^2.45.0",
    "postgres": "^3.4.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
