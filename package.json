{
  "name": "retail-sales-management",
  "private": true,
  "version": "1.0.0",
  "description": "Hybrid offline/online retail management system for Haitian stores - Bati yon biznis ki ap siviv ou",
  "workspaces": [
    "packages/*",
    "backend",
    "middleware",
    "mobile-app",
    "web-app",
    "admin-portal"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-expo-sqlite.js || true",
    "dev": "concurrently \"npm run dev:middleware\" \"npm run dev:web\"",
    "dev:all": "concurrently \"npm run dev:middleware\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:middleware": "npm run dev --workspace=middleware",
    "dev:web": "npm run dev --workspace=web-app",
    "dev:mobile": "npm run dev --workspace=mobile-app",
    "dev:sales": "npm run dev --prefix sales-site",
    "build:sales": "npm run build --prefix sales-site",
    "typecheck:sales": "npm run typecheck --prefix sales-site",
    "build": "npm run build --workspaces --if-present && npm run build:sales",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:sales",
    "brand": "node scripts/generate-brand.mjs",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:ci": "jest --ci --coverage"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "retail",
    "pos",
    "offline-first",
    "haiti",
    "creole",
    "supabase"
  ],
  "author": "Retail Sales Management",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.5",
    "eventemitter3": "^5.0.4",
    "expo": "~51.0.28",
    "fast-equals": "^6.0.2",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-router": "^6.30.6",
    "tiny-invariant": "^1.3.3",
    "victory-vendor": "^37.3.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "opentype.js": "^2.0.0",
    "playwright": "^1.64.1"
  }
}
