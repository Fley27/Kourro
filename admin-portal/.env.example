# ------------------------------------------------------------------
# Kourro Admin Portal — environment
# Copy to `.env` and fill in values. This project is standalone:
# it has its own .env, its own node_modules, its own lockfile.
# ------------------------------------------------------------------

# --- Web client (Vite) ---
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- API server ---
PORT=4200
# Direct Postgres connection used for migrations + all admin queries.
# Local Supabase: port 54322. Cloud: use the pooler connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Supabase Auth admin (staff login verification, owner/staff account creation).
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Billing rules ---
# Days after the renewal date an invoice may stay open before the subscription expires.
RENEWAL_GRACE_DAYS=7
# Subscriptions renewing within this many days show the "renewing soon" badge.
RENEWING_SOON_DAYS=14
# How often the billing job runs (ms).
BILLING_JOB_INTERVAL_MS=300000

# --- First super admin (used by `npm run bootstrap`) ---
ADMIN_EMAIL=super@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Platform Owner

# Owner receipt emails (Mailpit/Inbucket-compatible REST; unset = skipped with warning)
EMAIL_REST_URL=http://localhost:54324/api/v1/send
EMAIL_FROM=Kourro Billing <billing@kourro.test>
