# Web PWA build — same Supabase project + middleware as the mobile/tablet app.
# The shared app source reads these as process.env.EXPO_PUBLIC_*, injected at build time.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=anon-key
# Middleware host (sync arbiter). Use HTTPS in production — an HTTPS PWA cannot call http://.
# EXPO_PUBLIC_MIDDLEWARE_URL=http://192.168.1.10:4000
# Set to 1 to force real Supabase auth even against a local stack.
EXPO_PUBLIC_FORCE_LIVE_AUTH=1
